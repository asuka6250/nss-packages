diff --git a/Makefile b/Makefile
index e6be804..d5f186e 100644
--- a/Makefile
+++ b/Makefile
@@ -436,6 +436,11 @@ ccflags-$(ECM_BRIDGE_VLAN_FILTERING_ENABLE) += -DECM_BRIDGE_VLAN_FILTERING_ENABL
 # #############################################################################
 ccflags-$(ECM_FRONT_END_FSE_ENABLE) += -DECM_FRONT_END_FSE_ENABLE
 
+# #############################################################################
+# Define ECM_INTERFACE_WIFI_EVENTS_ENABLE=y to listen for nl80211 events.
+# #############################################################################
+ccflags-$(ECM_INTERFACE_WIFI_EVENTS_ENABLE) += -DECM_INTERFACE_WIFI_EVENTS_ENABLE
+
 # #############################################################################
 # Define ECM_256M_PROFILE=y in order to reduce hash slots for LM256 profile.
 # #############################################################################
diff --git a/ecm_interface.c b/ecm_interface.c
index 8643511..269cc2d 100644
--- a/ecm_interface.c
+++ b/ecm_interface.c
@@ -9707,7 +9707,9 @@ static struct ctl_table ecm_interface_table[] = {
 		.mode			= 0644,
 		.proc_handler		= &ecm_interface_mwan3_enable_handler,
 	},
+#if (LINUX_VERSION_CODE < KERNEL_VERSION(6, 11, 0))
 	{ }
+#endif
 };
 
 #ifdef ECM_INTERFACE_IPSEC_GLUE_LAYER_SUPPORT_ENABLE
@@ -10230,7 +10232,9 @@ int ecm_interface_init(void)
 #ifdef ECM_INTERFACE_OVS_BRIDGE_ENABLE
 	ovsmgr_notifier_register(&ecm_interface_ovs_notifier);
 #endif
+#ifdef ECM_INTERFACE_WIFI_EVENTS_ENABLE
 	ecm_interface_wifi_event_start();
+#endif
 
 	return 0;
 }
@@ -10262,7 +10266,9 @@ void ecm_interface_exit(void)
 		br_fdb_unregister_notify(&ecm_interface_node_br_fdb_delete_nb);
 	}
 #endif
+#ifdef ECM_INTERFACE_WIFI_EVENTS_ENABLE
 	ecm_interface_wifi_event_stop();
+#endif
 
 #ifdef ECM_INTERFACE_OVS_BRIDGE_ENABLE
 	ovsmgr_notifier_unregister(&ecm_interface_ovs_notifier);
